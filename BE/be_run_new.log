		LEFT JOIN users u ON t.user_id = u.id
		WHERE t.transaction_date BETWEEN '2026-07-01 00:00:00' AND '2026-07-24 23:59:59' GROUP BY t.user_id, u.full_name ORDER BY total_sales DESC LIMIT 10 OFFSET 0
