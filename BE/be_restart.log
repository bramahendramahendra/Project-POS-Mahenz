SELECT
    m.key_name,
    COALESCE(rma.can_view,   0) AS can_view,
    COALESCE(rma.can_create, 0) AS can_create,
    COALESCE(rma.can_edit,   0) AS can_edit,
    COALESCE(rma.can_delete, 0) AS can_delete
FROM menus m
LEFT JOIN role_menu_access rma ON rma.menu_id = m.id
