    COALESCE(rma.can_delete, 0) AS can_delete
FROM menus m
LEFT JOIN role_menu_access rma ON rma.menu_id = m.id
    AND rma.role_id = (SELECT id FROM roles WHERE name = 'owner' AND is_active = 1 LIMIT 1)
WHERE m.is_active = 1
ORDER BY m.id ASC

