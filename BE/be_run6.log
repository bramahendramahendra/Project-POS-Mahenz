		SELECT
			m.id,
			m.parent_id,
			m.key_name,
			m.label,
			m.icon,
			m.path,
			m.order_index,
			COALESCE(rma.can_view,   0),
			COALESCE(rma.can_create, 0),
			COALESCE(rma.can_edit,   0),
			COALESCE(rma.can_delete, 0)
		FROM menus m
		LEFT JOIN role_menu_access rma ON rma.menu_id = m.id
			AND rma.role_id = (SELECT id FROM roles WHERE name = 'admin' AND is_active = 1 LIMIT 1)
		WHERE m.is_active = 1
		ORDER BY m.order_index ASC, m.id ASC
		
