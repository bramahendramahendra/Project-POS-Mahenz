2026/07/23 08:55:06 [32mD:/Develop/Project_pos_mahenz/BE/domain/access/repo/access_repo.go:55
[0m[33m[1.014ms] [34;1m[rows:37][0m 
SELECT
    m.key_name,
    COALESCE(rma.can_view,   0) AS can_view,
    COALESCE(rma.can_create, 0) AS can_create,
    COALESCE(rma.can_edit,   0) AS can_edit,
    COALESCE(rma.can_delete, 0) AS can_delete
FROM menus m
LEFT JOIN role_menu_access rma ON rma.menu_id = m.id
    AND rma.role_id = (SELECT id FROM roles WHERE name = 'owner' AND is_active = 1 LIMIT 1)
WHERE m.is_active = 1
ORDER BY m.id ASC

